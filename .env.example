# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_qa
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/rag_qa

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
QUERY_CACHE_TTL_SECONDS=3600

# Auth
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM / Vector store
GROQ_API_KEY=your_groq_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=your_pinecone_index_name
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Graph database (Neo4j) - optional; ingestion logs a warning and continues
# without it if unset/unreachable (see app/services/graph_store.py)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-in-prod

# Observability - optional LangSmith tracing for every LangChain/LangGraph
# call (retrieve/grade/rewrite/graph_augment/generate). LangChain picks these
# up automatically; nothing else to configure. Leave TRACING_V2=false to
# disable - app-level structured JSON logs (see app/observability.py) don't
# need any of this set.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-document-qa

# Legacy HackRx grader endpoint
HACKRX_TOKEN=your_hackrx_grader_token_here

# AWS (optional — falls back to direct URL download if unset)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
